# 复制为 wecom.env（勿提交）。§2.1 与 §2.2 使用不同企业微信机器人 key。

# §2.1 ELK 定时任务监控
WECOM_WEBHOOK_URL_ELK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=ELK任务的key

# §2.2 WebSocket 探活
WECOM_WEBHOOK_URL_WS=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=WS任务的key

# 行情 API health（POST /terminal/quotes/api/health）
WECOM_WEBHOOK_URL_HEALTH=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=Health任务的key

# 自动化写稿任务验证（与 config/writing.env 中 SFC_WECHAT_WEBHOOK_URL 二选一）
WECOM_WEBHOOK_URL_WRITING=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=Writing任务的key

# 兼容旧配置（仅 §2.1 在未设置 WECOM_WEBHOOK_URL_ELK 时回退）
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
