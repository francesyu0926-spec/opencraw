# 复制为 config/health.env（已 gitignore，勿提交）。
# Token 来自登录接口，不要把 loginCode、password、JWT 或 webhook key 写进仓库。

# 登录取 Token（优先）。password 为 SHA256 hex，仍视为密钥。
# JWT 写入 config/health.token.cache.json（gitignore），默认 12 小时内复用，不重复登录。
QUOTES_LOGIN_CODE=
QUOTES_LOGIN_PASSWORD=

# 上面两项都未设置时，才使用静态 JWT
QUOTES_HEALTH_TOKEN=

# 行情 health 专用企业微信机器人（可与 WS/ELK 不同 key）
WECOM_WEBHOOK_URL_HEALTH=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的key
