# 统一监控调度（推荐）：每 5 分钟执行 HTTP health / WS / ELK（见 config/monitor_schedule.yaml）
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

*/5 * * * * /opt/opencraw/scripts/run_scheduled_monitors.sh >> /var/log/opencraw_monitors.log 2>&1

# --- 以下为拆分 cron（可选，与统一调度二选一）---
# */15 0-4 * * * ... python3 -m scripts.cron_task_monitor -c config/cron_tasks.yaml
# 0 5 * * * ... python3 -m scripts.cron_task_monitor -c config/cron_tasks.yaml
# */10 * * * * ... python3 -m scripts.cron_task_monitor --ws-monitor --json
# */5 * * * * ... python3 -m scripts.cron_task_monitor --health-monitor --json
