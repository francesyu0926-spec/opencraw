# §2.1 定时任务监控 — Linux cron
# 每天 00:00–05:00，每 15 分钟执行（0:00 … 4:45，以及 5:00）
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# 需事先 export：ELASTICSEARCH_PASSWORD、WECOM_WEBHOOK_URL
*/15 0-4 * * * cd /opt/opencraw && set -a && [ -f config/elk.env ] && . config/elk.env && [ -f config/wecom.env ] && . config/wecom.env && set +a && PYTHONPATH=. /usr/bin/python3 -m scripts.cron_task_monitor -c config/cron_tasks.yaml >> /var/log/cron_task_monitor.log 2>&1
0 5 * * * cd /opt/opencraw && set -a && [ -f config/elk.env ] && . config/elk.env && [ -f config/wecom.env ] && . config/wecom.env && set +a && PYTHONPATH=. /usr/bin/python3 -m scripts.cron_task_monitor -c config/cron_tasks.yaml >> /var/log/cron_task_monitor.log 2>&1

# §2.2 WebSocket：每 10 分钟（8:30-9:00 脚本内自动跳过）
*/10 * * * * cd /opt/opencraw && set -a && [ -f config/wecom.env ] && . config/wecom.env && set +a && PYTHONPATH=. /usr/bin/python3 -m scripts.cron_task_monitor --ws-monitor --json >> /var/log/ws_monitor.log 2>&1

# 行情 API health：每 5 分钟（需 QUOTES_HEALTH_TOKEN + WECOM_WEBHOOK_URL_HEALTH）
*/5 * * * * cd /opt/opencraw && set -a && [ -f config/health.env ] && . config/health.env && [ -f config/wecom.env ] && . config/wecom.env && set +a && PYTHONPATH=. /usr/bin/python3 -m scripts.cron_task_monitor --health-monitor --json >> /var/log/health_monitor.log 2>&1
