# 生产监控调度（推荐）：每 5 分钟触发调度器（见 config/monitor_schedule.production.yaml dispatcher_interval_minutes: 5）
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# 将 REPO 换成仓库根目录；日志路径可改
*/5 * * * * cd REPO && ./scripts/run_monitor_production.sh >> REPO/var/log/opencraw_monitors.log 2>&1

# 开发/旧表：每 5 分钟 run_scheduled_monitors.sh + monitor_schedule.yaml

# --- 以下为拆分 cron（可选，与统一调度二选一）---
# */15 0-4 * * * ... python3 -m scripts.cron_task_monitor -c config/cron_tasks.yaml
# 0 5 * * * ... python3 -m scripts.cron_task_monitor -c config/cron_tasks.yaml
# */10 * * * * ... python3 -m scripts.cron_task_monitor --ws-monitor --json
# */5 * * * * ... python3 -m scripts.cron_task_monitor --health-monitor --json
